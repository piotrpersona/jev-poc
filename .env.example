# HuggingFace encoder used as the shared backbone for state and schema text.
JEV_BACKBONE=answerdotai/ModernBERT-base

# torch device: auto | cpu | mps | cuda
JEV_DEVICE=auto

# Program state is unstructured text; ModernBERT handles up to 8192 tokens.
JEV_MAX_STATE_TOKENS=1024

# Option/question labels are short.
JEV_MAX_OPTION_TOKENS=32

# States per forward pass.
JEV_BATCH_SIZE=8

# Keep model + dataset downloads inside the repo (gitignored).
HF_HOME=.hf-cache

# MLflow experiment tracking for `jev train`.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=jev-poc
